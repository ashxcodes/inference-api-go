MODEL_API_KEY=change-me
MODEL_DIR=/models
PORT=8456
PREDICT_CONCURRENCY=0
PREDICT_MAX_IN_FLIGHT=320
PREDICT_MAX_WAITERS=64
PREDICT_RETRY_AFTER_SECONDS=1
SHUTDOWN_HTTP=30s

# OpenTelemetry (SDK + otelhttp in cmd/server — standard go build).
# Disable entirely: OTEL_SDK_DISABLED=true
# Disable signals: OTEL_TRACES_EXPORTER=none (same for METRICS/LOGS)
OTEL_SERVICE_NAME=ml-model-go
# gRPC gateway (4317): OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# HTTP gateway (4318): OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTLP endpoint — pick ONE profile:
#   In-cluster pod:
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://otelcol-gateway.otel-collector.svc.cluster.local:4317
#   Docker bench on host (BENCH_OTLP=1; gateway port-forward on laptop):
#     kubectl port-forward --address 0.0.0.0 -n otel-collector svc/otelcol-gateway 4317:4317
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
#   Native process on host, same port-forward:
#     OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_TRACES_SAMPLER=always_on

OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=staging,service.namespace=inference-api,service.instance.id=ml-instance-0
HOSTNAME=ml-instance-0

# Inbound HTTP traces + http.server.*: otelhttp (cmd/server).
# go_* runtime metrics: contrib/runtime (on when OTEL_METRICS_EXPORTER is not none).
# process.cpu.time + system_*: contrib/host (not process.cpu.utilization / process.memory.usage).
# OTEL_GO_SYSTEM_METRICS=false to disable host instrumentation.
# OTEL_GO_RUNTIME_METRICS=false   # disable go_* only
# OTEL_GO_HTTP_OTELHTTP=false     # disable otelhttp wrapper only
